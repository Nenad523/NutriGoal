@{
    ViewBag.Title = "NutriGoal";
}

<style>
    body {
        background-color: #F5F0E8;
    }
</style>

<section style="max-width: 1280px; margin: 0 auto; padding: 90px 24px 80px 24px;">

    <p style="font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #C87941; margin: 0 0 20px 0;">
        Personalizovana ishrana
    </p>

    <h1 style="font-size: clamp(40px, 5vw, 64px); font-weight: 800; line-height: 1.1; color: #111827; margin: 0 0 24px 0; max-width: 720px;">
        Pametnija ishrana uz nauku,
        <span style="color: #1C3D2E; font-style: italic;"> prilagodjena vama.</span>
    </h1>

    <p style="font-size: 16px; color: #6b7280; line-height: 1.6; max-width: 480px; margin: 0 0 40px 0;">
        Zaboravite genericke dijete. NutriGoal analizira vas metabolizam, ciljeve i
        alergije kako bi kreirao plan obroka koji zaista volite jesti.
    </p>

    <div style="display: flex; align-items: center; gap: 24px; flex-wrap: wrap;">
        @Html.ActionLink("-> Pocni odmah", "Register", "Korisnik", null, new
        {
            style = "background: #1C3D2E; color: white; padding: 14px 28px; border-radius: 50px; font-size: 15px; font-weight: 600; text-decoration: none; display: inline-block;"
        })
        @Html.ActionLink("Pregledaj recepte", "Index", "Recept", null, new
        {
            style = "color: #374151; font-size: 15px; font-weight: 500; text-decoration: none;"
        })
    </div>

</section>
