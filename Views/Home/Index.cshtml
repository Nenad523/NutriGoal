@{
    ViewBag.Title = "NutriGoal";
}

<style>
    body {
        background-color: #F5F0E8;
    }

    .preporucena-kartica {
        text-decoration: none;
        color: inherit;
        display: block;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #ddd8ce;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .preporucena-kartica:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }
</style>

<!-- POCETAK HEARO SEKCIJE -->
<section style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 7vw, 90px) 24px clamp(40px, 6vw, 80px) 24px;">

    <p style="font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #C87941; margin: 0 0 20px 0;">
        Personalizovana ishrana
    </p>

    <h1 style="font-size: clamp(40px, 5vw, 64px); font-weight: 800; line-height: 1.1; color: #111827; margin: 0 0 24px 0; max-width: 720px;">
        Pametnija ishrana uz nauku,
        <span style="color: #1C3D2E; font-style: italic;"> prilagođena vama.</span>
    </h1>

    <p style="font-size: 16px; color: #6b7280; line-height: 1.6; max-width: 480px; margin: 0 0 40px 0;">
        Zaboravite generičke dijete. NutriGoal analizira vaš metabolizam, ciljeve i
        alergije kako bi kreirao plan obroka koji zaista volite jesti.
    </p>

    <div style="display: flex; align-items: center; gap: 24px; flex-wrap: wrap;">
        @Html.ActionLink("→ Počni odmah", "Register", "Korisnik", null, new
        {
            style = "background: #1C3D2E; color: white; padding: 14px 28px; border-radius: 50px; font-size: 15px; font-weight: 600; text-decoration: none; display: inline-block;"
        })
        @Html.ActionLink("Pregledaj recepte", "Index", "Recept", null, new
        {
            style = "color: #374151; font-size: 15px; font-weight: 500; text-decoration: none;"
        })
    </div>

</section>
<!-- KRAJ HEARO SEKCIJE -->

<!-- POCETAK SEKCIJE PREPORUCENIH RECEPATA -->
@{
    var preporuceniRecepti = ViewBag.PreporuceniRecepti as List<NutriGoal.Models.ReceptViewModel>;
}
@if (preporuceniRecepti != null && preporuceniRecepti.Count > 0)
{
    <section style="background-color: #EDE8DE; width: 100vw; position: relative; left: 50%; margin-left: -50vw; padding: clamp(40px, 5vw, 70px) 24px;">
        <div style="max-width: 1280px; margin: 0 auto;">

            <div style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 36px; flex-wrap: wrap; gap: 12px;">
                <div>
                    <p style="font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #C87941; margin: 0 0 10px 0;">Za ovo doba dana</p>
                    <h2 style="font-size: clamp(28px, 3.5vw, 42px); font-weight: 700; color: #111827; margin: 0 0 8px 0;">@ViewBag.NaslovObroka</h2>
                    <p style="font-size: 14px; color: #6b7280; margin: 0;">@ViewBag.OpisObroka</p>
                </div>
                @Html.ActionLink("Svi recepti →", "Index", "Recept", null, new
                {
                    style = "font-size: 14px; font-weight: 500; color: #1C3D2E; text-decoration: none; white-space: nowrap;"
                })
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 28px;">
                @foreach (var recept in preporuceniRecepti)
                {
                    <a href="@Url.Action("Details", "Recept", new { id = recept.Id })" class="preporucena-kartica">

                        <div style="position: relative; height: 240px; overflow: hidden;">
                            @if (!string.IsNullOrEmpty(recept.Fotografija))
                            {
                                <img src="@recept.Fotografija" alt="@recept.Naziv"
                                     style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div style="width: 100%; height: 100%; background: #D4E8D4; display: flex; align-items: center; justify-content: center;">
                                    <span style="font-size: 56px;">🥗</span>
                                </div>
                            }
                            <span style="position: absolute; top: 14px; left: 14px; background: rgba(0,0,0,0.5); color: white; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 12px; border-radius: 50px;">
                                @ViewBag.KategorijaObroka
                            </span>
                        </div>

                        <div style="padding: 20px;">
                            <p style="font-size: 18px; font-weight: 700; color: #111827; margin: 0 0 12px 0;">@recept.Naziv</p>
                            <div style="display: flex; align-items: center; gap: 20px;">
                                <span style="font-size: 14px; font-weight: 500; color: #4b5563;">⏱ @recept.VrijemePripreme min</span>
                                @if (recept.Kalorije.HasValue)
                                {
                                    <span style="font-size: 14px; font-weight: 500; color: #4b5563;">🔥 @recept.Kalorije kcal</span>
                                }
                            </div>
                        </div>

                    </a>
                }
            </div>

        </div>
    </section>
}
<!-- KRAJ SEKCIJE PREPORUCENIH RECEPATA -->

<!-- POCETAK SEKCIJE 3 KORAKA -->
<section style="background-color: #162C20; padding: clamp(40px, 5vw, 70px) 24px; width: 100vw; position: relative; left: 50%; right: 50%; margin-left: -50vw; margin-right: -50vw;">
    <div style="max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 48px;">

        <div>
            <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #C87941; margin: 0 0 12px 0;">01. Korak</p>
            <h3 style="font-size: 22px; font-weight: 700; color: white; margin: 0 0 12px 0;">Postavi cilj</h3>
            <p style="font-size: 14px; color: #9db8a8; line-height: 1.6; margin: 0;">Unesite mjere, nivo aktivnosti i šta želite postići.</p>
        </div>

        <div>
            <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #C87941; margin: 0 0 12px 0;">02. Korak</p>
            <h3 style="font-size: 22px; font-weight: 700; color: white; margin: 0 0 12px 0;">Dobij preporuke</h3>
            <p style="font-size: 14px; color: #9db8a8; line-height: 1.6; margin: 0;">Naš algoritam filtrira recepte prema vašem metabolizmu i alergijama.</p>
        </div>

        <div>
            <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #C87941; margin: 0 0 12px 0;">03. Korak</p>
            <h3 style="font-size: 22px; font-weight: 700; color: white; margin: 0 0 12px 0;">Jedi pametno</h3>
            <p style="font-size: 14px; color: #9db8a8; line-height: 1.6; margin: 0;">Uživajte u hrani koja vas približava idealnom balansu.</p>
        </div>

    </div>
</section>
<!-- KRAJ SEKCIJE 3 KORAKA -->

<!-- POCETAK SEKCIJE CILJEVI -->
<section style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 6vw, 80px) 24px;">

    <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 40px;">
        <h2 style="font-size: clamp(28px, 4vw, 44px); font-weight: 800; color: #111827; margin: 0;">
            Tri jasna cilja, jedan put.
        </h2>
        <p style="font-size: 14px; color: #6b7280; margin: 0; max-width: 360px; text-align: right; line-height: 1.6;">
            Odaberite svoj cilj, a mi ćemo posložiti makronutrijente i recepte.
        </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        <!-- KARTICA: MRSAVLJENJE -->
        <div style="background: white; border-radius: 20px; border: 1px solid #e5e7eb; padding: 28px; display: flex; flex-direction: column; gap: 20px;">

            <div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                    <span style="font-size: 28px;">🔥</span>
                    <h3 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0;">Mršavljenje</h3>
                </div>
                <p style="font-size: 14px; color: #6b7280; line-height: 1.6; margin: 0;">
                    Smanjeni kalorijski deficit + visok unos proteina za očuvanje mišića i vitalnost.
                </p>
            </div>

            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <span style="background: #D4E8D4; color: #1C3D2E; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 50px;">↑ Proteini</span>
                <span style="background: #EDE8DE; color: #374151; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 50px;">↓ Ugljeni hidrati</span>
                <span style="background: #EDE8DE; color: #374151; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 50px;">= Masti</span>
            </div>

            <div>
                <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #C87941; margin: 0 0 10px 0;">Preporučene namirnice</p>
                <ul style="margin: 0; padding-left: 18px; font-size: 13px; color: #374151; line-height: 1.8;">
                    <li>Pileća prsa, ćuretina, tuna, jaja, grčki jogurt</li>
                    <li>Vlaknaste žitarice: zob, ječam, kinoa, hljeb od cjelovitog zrna</li>
                    <li>Voće s vlaknima: bobice, jabuka, kruška, kivi, grejp</li>
                </ul>
            </div>

            <div>
                <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #C87941; margin: 0 0 10px 0;">⚠ Izbjegavati</p>
                <ul style="margin: 0; padding-left: 18px; font-size: 13px; color: #374151; line-height: 1.8;">
                    <li><strong>Tečne kalorije:</strong> sokovi, gazirana pića, slatke kafe</li>
                    <li><strong>Ultra-prerađena hrana:</strong> čips, keksi, instant tijesta</li>
                    <li><strong>Pržena hrana:</strong> pomfrit, pohano meso — visok kalorijski gustoć</li>
                </ul>
            </div>

            @Html.ActionLink("Odaberi ovaj cilj →", "Profil", "Korisnik", null, new { style = "display: block; text-align: center; background: #1C3D2E; color: white; padding: 13px 24px; border-radius: 50px; font-size: 14px; font-weight: 600; text-decoration: none; margin-top: auto;" })
        </div>

        <!-- KARTICA: IZGRADNJA MISICA -->
        <div style="background: white; border-radius: 20px; border: 1px solid #e5e7eb; padding: 28px; display: flex; flex-direction: column; gap: 20px;">

            <div>
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                    <span style="font-size: 28px;">💪</span>
                    <h3 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0;">Izgradnja mišića</h3>
                </div>
                <p style="font-size: 14px; color: #6b7280; line-height: 1.6; margin: 0;">
                    Kalorijski suficit + progresivan trening snage za maksimalan rast mišićne mase.
                </p>
            </div>

            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                <span style="background: #D4E8D4; color: #1C3D2E; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 50px;">↑ Proteini</span>
                <span style="background: #D4E8D4; color: #1C3D2E; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 50px;">↑ Ugljeni hidrati</span>
                <span style="background: #EDE8DE; color: #374151; font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 50px;">= Masti</span>
            </div>

            <div>
                <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #C87941; margin: 0 0 10px 0;">Preporučene namirnice</p>
                <ul style="margin: 0; padding-left: 18px; font-size: 13px; color: #374151; line-height: 1.8;">
                    <li>Kvalitetni proteini: govedina, losos, tuna, jaja, mlijeko, sir</li>
                    <li>Kompleksni UH: zob, smeđi pirinač, krompir, integralna pasta</li>
                    <li>Oporavak: jogurt, kefir, svježi sir — oporavak 24–72h</li>
                </ul>
            </div>

            <div>
                <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #C87941; margin: 0 0 10px 0;">⚠ Izbjegavati</p>
                <ul style="margin: 0; padding-left: 18px; font-size: 13px; color: #374151; line-height: 1.8;">
                    <li><strong>Prazne kalorije:</strong> alkohol — smanjuje sintezu proteina</li>
                    <li><strong>Prekomjerno kardio:</strong> duge trke svaki dan crpe energiju za rast</li>
                    <li><strong>Preskakanje obroka:</strong> razmak više od 5h smanjuje mišićnu sintezu</li>
                </ul>
            </div>

            @Html.ActionLink("Odaberi ovaj cilj →", "Profil", "Korisnik", null, new { style = "display: block; text-align: center; background: #1C3D2E; color: white; padding: 13px 24px; border-radius: 50px; font-size: 14px; font-weight: 600; text-decoration: none; margin-top: auto;" })
        </div>

        <!-- kartice idu ovdje -->
    </div>

</section>
<!-- KRAJ SEKCIJE CILJEVI -->

@if (Session["KorisnikId"] == null)
{
    <!-- POCETAK CTA SEKCIJE -->
    <section style="max-width: 1280px; margin: 0 auto; padding: clamp(40px, 5vw, 70px) 24px;">
        <div style="background-color: #EDE8DE; border-radius: 20px; padding: clamp(32px, 5vw, 64px) 24px; text-align: center; max-width: 860px; margin: 0 auto; border: 1px solid #cec9c0;">

            <h2 style="font-size: 32px; font-weight: 800; color: #111827; margin: 0 0 12px 0;">Spremni za prvi korak?</h2>
            <p style="font-size: 15px; color: #6b7280; margin: 0 0 32px 0;">Registracija traje minut. Profil i preporuke su besplatni.</p>

            @Html.ActionLink("Kreiraj nalog", "Register", "Korisnik", null, new
            {
                style = "background: #1C3D2E; color: white; padding: 14px 32px; border-radius: 50px; font-size: 15px; font-weight: 600; text-decoration: none; display: inline-block;"
            })

        </div>
    </section>
    <!-- KRAJ CTA SEKCIJE -->
}
