@{
    ViewBag.Title = "Kontakt";
}

<style>
    body { background-color: #F5F0E8; }
</style>

<section style="max-width: 640px; margin: 0 auto; padding: clamp(48px, 6vw, 80px) 24px;">

    <p style="font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #C87941; margin: 0 0 12px 0;">Kontakt</p>
    <h1 style="font-size: clamp(28px, 4vw, 42px); font-weight: 600; color: #111827; margin: 0 0 16px 0;">Stupite u kontakt</h1>
    <p style="font-size: 15px; color: #6b7280; line-height: 1.6; margin: 0 0 40px 0;">
        Imate pitanja, prijedloge ili povratne informacije? Slobodno pišite.
    </p>

    <div style="background: white; border-radius: 20px; border: 1px solid #e5e7eb; padding: clamp(24px, 4vw, 40px); display: flex; flex-direction: column; gap: 20px;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 44px; height: 44px; background: #F5F0E8; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">✉</div>
            <div>
                <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280; margin: 0 0 4px 0;">Email</p>
                <a href="mailto:nenadpopovic3210@gmail.com" style="font-size: 15px; color: #1C3D2E; font-weight: 500; text-decoration: none;">nenadpopovic3210@gmail.com</a>
            </div>
        </div>
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 44px; height: 44px; background: #F5F0E8; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0;">🐙</div>
            <div>
                <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280; margin: 0 0 4px 0;">GitHub</p>
                <a href="https://github.com/Nenad523" target="_blank" style="font-size: 15px; color: #1C3D2E; font-weight: 500; text-decoration: none;">github.com/Nenad523</a>
            </div>
        </div>
    </div>

</section>
