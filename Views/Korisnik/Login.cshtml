@model NutriGoal.Models.LoginViewModel

@{
    ViewBag.Title = "Prijava";
}

<style>
    body {
        background-color: #F5F0E8;
    }

    .ng-auth-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
        padding: 40px;
        width: 100%;
        max-width: 460px;
    }

    .ng-field-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: 8px;
    }

    .ng-input {
        display: block;
        width: 100%;
        max-width: 100%;
        background: #F5F0E8;
        border: none;
        border-radius: 50px;
        padding: 13px 20px;
        font-size: 14px;
        color: #1C3D2E;
        outline: none;
        box-sizing: border-box;
    }

    .ng-input:focus {
        box-shadow: 0 0 0 2px rgba(28, 61, 46, 0.25);
    }

    .ng-submit-btn {
        display: block;
        width: 100%;
        background: #1C3D2E;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 8px;
        transition: background 0.15s;
    }

    .ng-submit-btn:hover {
        background: #163028;
    }

    .ng-validation-error {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 5px;
        padding-left: 4px;
    }
</style>

<div style="min-height: calc(100vh - 130px); display: flex; align-items: center; justify-content: center; padding: 40px 16px;">
    <div class="ng-auth-card">

        <h2 style="font-size: 28px; font-weight: 700; color: #1C3D2E; margin: 0 0 6px 0;">Prijava</h2>
        <p style="color: #9ca3af; font-size: 14px; margin: 0 0 28px 0;">Dobrodošli nazad u NutriGoal.</p>

        @using (Html.BeginForm("Login", "Korisnik", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div style="margin-bottom: 20px;">
                <label class="ng-field-label">Email</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "ng-input" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "ng-validation-error" })
            </div>

            <div style="margin-bottom: 28px;">
                <label class="ng-field-label">Lozinka</label>
                @Html.PasswordFor(m => m.Password, new { @class = "ng-input" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "ng-validation-error" })
            </div>

            <button type="submit" class="ng-submit-btn">Prijavi se</button>
        }

        <p style="text-align: center; font-size: 14px; color: #9ca3af; margin: 20px 0 0 0;">
            Nemate nalog?
            @Html.ActionLink("Registracija", "Register", "Korisnik", null, new
            {
                style = "color: #1C3D2E; font-weight: 700; text-decoration: none;"
            })
        </p>

    </div>
</div>
