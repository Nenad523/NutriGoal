@model NutriGoal.Models.ProfilViewModel

@{
    ViewBag.Title = "Moj profil";
}

<style>
    body {
        background-color: #F5F0E8;
    }

    .ng-field-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: 8px;
    }

    .ng-input {
        display: block;
        width: 100%;
        max-width: 100%;
        background: #F5F0E8;
        border: none;
        border-radius: 50px;
        padding: 13px 20px;
        font-size: 14px;
        color: #1C3D2E;
        outline: none;
        box-sizing: border-box;
    }

    .ng-input:focus {
        box-shadow: 0 0 0 2px rgba(28, 61, 46, 0.25);
    }

    .ng-select {
        display: block;
        width: 100%;
        max-width: 100%;
        background: #F5F0E8;
        border: none;
        border-radius: 12px;
        padding: 13px 20px;
        font-size: 14px;
        color: #1C3D2E;
        outline: none;
        box-sizing: border-box;
        appearance: none;
        cursor: pointer;
    }

    .ng-select:focus {
        box-shadow: 0 0 0 2px rgba(28, 61, 46, 0.25);
    }

    .ng-submit-btn {
        display: block;
        width: 100%;
        background: #1C3D2E;
        color: white;
        border: none;
        border-radius: 50px;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 8px;
        transition: background 0.15s;
    }

    .ng-submit-btn:hover {
        background: #163028;
    }

    .ng-validation-error {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 5px;
        padding-left: 4px;
    }

    .ng-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    @@media (max-width: 480px) {
        .ng-two-col {
            grid-template-columns: 1fr;
        }
    }
</style>

<div style="min-height: calc(100vh - 130px); display: flex; align-items: center; justify-content: center; padding: 40px 16px;">
    <div style="background: white; border-radius: 20px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); padding: 40px; width: 100%; max-width: 560px;">

        <h2 style="font-size: 28px; font-weight: 700; color: #1C3D2E; margin: 0 0 6px 0;">Moj profil</h2>
        <p style="color: #9ca3af; font-size: 14px; margin: 0 0 28px 0;">Unesite vaše podatke kako bismo personalizovali preporuke.</p>

        @using (Html.BeginForm("Profil", "Korisnik", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="ng-two-col" style="margin-bottom: 20px;">
                <div>
                    <label class="ng-field-label">Ime</label>
                    @Html.TextBoxFor(m => m.Ime, new { @class = "ng-input", placeholder = "Marko" })
                    @Html.ValidationMessageFor(m => m.Ime, "", new { @class = "ng-validation-error" })
                </div>
                <div>
                    <label class="ng-field-label">Prezime</label>
                    @Html.TextBoxFor(m => m.Prezime, new { @class = "ng-input", placeholder = "Markovic" })
                    @Html.ValidationMessageFor(m => m.Prezime, "", new { @class = "ng-validation-error" })
                </div>
            </div>

            <div class="ng-two-col" style="margin-bottom: 20px;">
                <div>
                    <label class="ng-field-label">Datum rođenja</label>
                    @Html.TextBoxFor(m => m.DatumRodjenja, "{0:yyyy-MM-dd}", new { @type = "date", @class = "ng-input" })
                    @Html.ValidationMessageFor(m => m.DatumRodjenja, "", new { @class = "ng-validation-error" })
                </div>
                <div>
                    <label class="ng-field-label">Pol</label>
                    @Html.DropDownListFor(m => m.Pol,
                        new SelectList(new[] {
                            new { Value = "M", Text = "Muški" },
                            new { Value = "Z", Text = "Ženski" }
                        }, "Value", "Text"),
                        "Odaberite pol", new { @class = "ng-select" })
                </div>
            </div>

            <div class="ng-two-col" style="margin-bottom: 20px;">
                <div>
                    <label class="ng-field-label">Visina (cm)</label>
                    @Html.TextBoxFor(m => m.Visina, "{0:F0}", new { @type = "number", @class = "ng-input", @step = "1", @min = "50", @max = "300", placeholder = "175" })
                    @Html.ValidationMessageFor(m => m.Visina, "", new { @class = "ng-validation-error" })
                </div>
                <div>
                    <label class="ng-field-label">Težina (kg)</label>
                    @Html.TextBoxFor(m => m.Tezina, "{0:F0}", new { @type = "number", @class = "ng-input", @step = "1", @min = "20", @max = "500", placeholder = "75" })
                    @Html.ValidationMessageFor(m => m.Tezina, "", new { @class = "ng-validation-error" })
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <label class="ng-field-label">Nivo aktivnosti</label>
                @Html.DropDownListFor(m => m.NivoAktivnosti,
                    new SelectList(new[] {
                        new { Value = 1, Text = "Sjedilački način života" },
                        new { Value = 2, Text = "Lagana aktivnost (1-3 dana)" },
                        new { Value = 3, Text = "Umjerena aktivnost (3-5 dana)" },
                        new { Value = 4, Text = "Visoka aktivnost (6-7 dana)" }
                    }, "Value", "Text"),
                    "Odaberite nivo aktivnosti", new { @class = "ng-select" })
            </div>

            <div style="margin-bottom: 28px;">
                <label class="ng-field-label">Cilj</label>
                @Html.DropDownListFor(m => m.CiljId,
                    new SelectList(ViewBag.Ciljevi, "Id", "Naziv"),
                    "-- Izaberi cilj --",
                    new { @class = "ng-select" })
            </div>

            <div style="margin-bottom: 28px;">
                <label class="ng-field-label" style="margin-bottom: 12px;">Alergije</label>
                <p style="font-size: 13px; color: #6b7280; margin: 0 0 14px 0;">Označite namirnice na koje ste alergični. Recepti koji ih sadrže bit će označeni upozorenjem.</p>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    @foreach (var alergija in ViewBag.Alergije as List<NutriGoal.Models.Alergije>)
                    {
                        var odabrana = Model.OdabraneAlergijeIds.Contains(alergija.Id);
                        var borderBoja = odabrana ? "#1C3D2E" : "transparent";
                        <label style="display: flex; align-items: center; gap: 10px; background: #F5F0E8; border-radius: 12px; padding: 12px 16px; cursor: pointer; border: 2px solid @borderBoja; transition: border-color 0.15s;">
                            <input type="checkbox"
                                   name="OdabraneAlergijeIds"
                                   value="@alergija.Id"
                                   @(odabrana ? "checked" : "")
                                   style="accent-color: #1C3D2E; width: 16px; height: 16px; cursor: pointer; flex-shrink: 0;" />
                            <span style="font-size: 14px; font-weight: 500; color: #111827;">@alergija.Naziv</span>
                        </label>
                    }
                </div>
            </div>

            <button type="submit" class="ng-submit-btn">Sačuvaj profil</button>
        }

    </div>
</div>
