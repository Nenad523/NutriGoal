@model NutriGoal.Models.ReceptFormViewModel

@{
    bool jeUredivanje = Model.Id > 0;
    ViewBag.Title = jeUredivanje ? "Uredi recept" : "Dodaj recept";
}

<style>
    body { background-color: #F5F0E8; }

    .forma-wrapper {
        max-width: 860px;
        margin: 0 auto;
        padding: clamp(28px, 4vw, 48px) 24px clamp(48px, 6vw, 80px) 24px;
    }

    .forma-card {
        background: white;
        border-radius: 20px;
        border: 1px solid #e5e7eb;
        padding: clamp(24px, 4vw, 40px);
    }

    .ng-field-label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: 8px;
    }

    .ng-input {
        display: block;
        width: 100%;
        background: #F5F0E8;
        border: none;
        border-radius: 50px;
        padding: 13px 20px;
        font-size: 14px;
        color: #1C3D2E;
        outline: none;
        box-sizing: border-box;
    }

    .ng-input:focus { box-shadow: 0 0 0 2px rgba(28, 61, 46, 0.25); }

    .ng-textarea {
        display: block;
        width: 100%;
        background: #F5F0E8;
        border: none;
        border-radius: 16px;
        padding: 13px 20px;
        font-size: 14px;
        color: #1C3D2E;
        outline: none;
        box-sizing: border-box;
        resize: vertical;
        font-family: inherit;
    }

    .ng-textarea:focus { box-shadow: 0 0 0 2px rgba(28, 61, 46, 0.25); }

    .ng-select {
        display: block;
        width: 100%;
        background: #F5F0E8;
        border: none;
        border-radius: 12px;
        padding: 13px 20px;
        font-size: 14px;
        color: #1C3D2E;
        outline: none;
        box-sizing: border-box;
        appearance: none;
        cursor: pointer;
    }

    .ng-select:focus { box-shadow: 0 0 0 2px rgba(28, 61, 46, 0.25); }

    .ng-validation-error {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 5px;
        padding-left: 4px;
    }

    .ng-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .section-divider {
        border: none;
        border-top: 1px solid #f3f4f6;
        margin: 28px 0;
    }

    .section-title {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #C87941;
        margin: 0 0 20px 0;
    }

    @@media (max-width: 600px) {
        .ng-two-col { grid-template-columns: 1fr; }
    }
</style>

<div class="forma-wrapper">
    <div style="margin-bottom: 28px;">
        <p style="font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #C87941; margin: 0 0 8px 0;">Administracija</p>
        <h1 style="font-size: clamp(24px, 3vw, 36px); font-weight: 600; color: #111827; margin: 0;">@ViewBag.Title</h1>
    </div>

    <div class="forma-card">

    </div>
</div>
