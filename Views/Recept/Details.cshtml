@model NutriGoal.Models.ReceptDetaljiViewModel

@{
    ViewBag.Title = Model.Naziv;
}

<style>
    body { background-color: #F5F0E8; }

    /* HERO */
    .hero {
        position: relative;
        width: 100%;
        height: 420px;
        overflow: hidden;
    }
    .hero-slika {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .hero-placeholder {
        width: 100%;
        height: 100%;
        background: #D4E8D4;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 80px;
    }
    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);
    }
    .hero-vrh {
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .hero-kategorija {
        background: rgba(0,0,0,0.5);
        color: white;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 6px 14px;
        border-radius: 50px;
    }
    .hero-nazad {
        background: rgba(255,255,255,0.9);
        color: #111827;
        font-size: 13px;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 50px;
        text-decoration: none;
    }
    .hero-nazad:hover {
        background: white;
        color: #111827;
        text-decoration: none;
    }
    .hero-dno {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px 28px 24px;
    }
    .hero-vrijeme {
        font-size: 14px;
        font-weight: 500;
        color: rgba(255,255,255,0.85);
        margin: 0 0 12px 0;
    }
    .hero-naziv {
        font-size: clamp(28px, 4vw, 48px);
        font-weight: 700;
        color: white;
        margin: 0;
        line-height: 1.2;
    }

    @@media (max-width: 768px) {
        .hero { height: 320px; }
    }
</style>

<!-- HERO -->
<div class="hero">
    @if (!string.IsNullOrEmpty(Model.Fotografija))
    {
        <img class="hero-slika" src="@Model.Fotografija" alt="@Model.Naziv" />
    }
    else
    {
        <div class="hero-placeholder">🥗</div>
    }
    <div class="hero-overlay"></div>

    <div class="hero-vrh">
        <span class="hero-kategorija">@Model.KategorijaIme</span>
        @Html.ActionLink("← Nazad na recepte", "Index", "Recept", null, new { @class = "hero-nazad" })
    </div>

    <div class="hero-dno">
        <p class="hero-vrijeme">⏱ @Model.VrijemePripreme min</p>
        <h1 class="hero-naziv">@Model.Naziv</h1>
    </div>
</div>
