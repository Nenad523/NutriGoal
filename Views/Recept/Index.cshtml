@model List<NutriGoal.Models.ReceptViewModel>

@{
    ViewBag.Title = "Recepti";
}

<style>
    body {
        background-color: #F5F0E8;
    }
</style>

<!-- POCETAK HEADER SEKCIJE -->
<section style="max-width: 1280px; margin: 0 auto; padding: clamp(48px, 7vw, 90px) 24px 32px 24px;">

    <p style="font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #C87941; margin: 0 0 16px 0;">
        Biblioteka recepata
    </p>

    <h1 style="font-size: clamp(32px, 4vw, 52px); font-weight: 800; color: #111827; margin: 0;">
        Istražite recepte
    </h1>

</section>
<!-- KRAJ HEADER SEKCIJE -->
